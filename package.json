{
  "name": "vnsf-scholarship-management",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @vnsf/api test:integration",
    "test:e2e": "pnpm --filter @vnsf/web test:e2e",
    "test:security": "pnpm --filter @vnsf/api test:security",
    "test:perf": "k6 run tests/performance/smoke.js",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "dev": "pnpm --parallel --filter @vnsf/api --filter @vnsf/worker --filter @vnsf/web dev",
    "contracts:validate": "pnpm --filter @vnsf/contracts validate",
    "db:migrate": "pnpm --filter @vnsf/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "eslint": "9.30.1",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1"
  }
}
