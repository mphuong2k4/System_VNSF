{
  "name": "vnsf-scholarship-management",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "glob": "11.1.0",
      "js-yaml": "4.3.1",
      "multer": "2.2.0",
      "nanoid": "3.3.17",
      "path-to-regexp": "8.4.0",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @vnsf/api test:integration && pnpm --filter @vnsf/worker test:integration",
    "test:e2e": "pnpm --filter @vnsf/web test:e2e",
    "test:security": "pnpm --filter @vnsf/api test:security",
    "test:perf": "node tests/performance/smoke.mjs",
    "test:perf:k6": "k6 run tests/performance/smoke.js",
    "test:dr": "node tests/operations/backup-restore.mjs",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "dev": "pnpm --parallel --filter @vnsf/api --filter @vnsf/worker --filter @vnsf/web dev",
    "contracts:validate": "pnpm --filter @vnsf/contracts validate",
    "db:migrate": "pnpm --filter @vnsf/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "eslint": "9.30.1",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1"
  }
}
