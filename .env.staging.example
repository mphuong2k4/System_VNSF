APP_ENV=staging
APP_BASE_URL=https://staging.example.invalid
APP_TIMEZONE=Asia/Ho_Chi_Minh
SUPPORTED_LOCALES=vi-VN,en-US
DATABASE_URL=postgresql://replace-with-secret-manager-value
REDIS_URL=rediss://replace-with-secret-manager-value
SESSION_SECRET_CURRENT=replace-with-at-least-32-random-characters
SESSION_SECRET_PREVIOUS=replace-with-previous-32-character-secret
FIELD_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
FIELD_HMAC_KEY_BASE64=replace-with-independent-32-byte-base64-key
OBJECT_STORAGE_ENDPOINT=https://object-storage.example.invalid
OBJECT_STORAGE_BUCKET=vnsf-staging-private
OBJECT_STORAGE_ACCESS_KEY=replace-with-secret-manager-value
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-manager-value
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.invalid
SMTP_URL=smtp://replace-with-secret-manager-value
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
