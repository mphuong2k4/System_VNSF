{
  "name": "@vnsf/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:integration": "vitest run test/integration --no-file-parallelism --maxWorkers=1",
    "test:security": "vitest run test/security",
    "seed:e2e": "node test/e2e-seed.mjs",
    "seed:demo-admin": "node test/demo-admin-seed.mjs",
    "db:migrate": "node dist/database/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@nestjs/common": "11.1.3",
    "@nestjs/core": "11.1.3",
    "@nestjs/platform-express": "11.1.3",
    "@vnsf/config": "workspace:*",
    "argon2": "0.43.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "file-type": "^22.0.1",
    "helmet": "8.1.0",
    "otplib": "12.0.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.7",
    "@nestjs/testing": "11.1.3",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "24.0.10",
    "@types/pg": "8.15.4",
    "eslint": "9.30.1",
    "supertest": "7.1.3",
    "typescript": "5.8.3",
    "vitest": "3.2.6"
  }
}
